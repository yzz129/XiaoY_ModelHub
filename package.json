{
  "name": "xiaoy-modelhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43129 --strictPort",
    "dev:backend": "wrangler pages dev dist --port 8788",
    "dev:agent": "wrangler dev --config wrangler.agent.jsonc --test-scheduled",
    "deploy:agent": "wrangler deploy --config wrangler.agent.jsonc",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/agent-workflow.test.js tests/agent-runtime.test.js tests/agent-evaluation.test.js tests/agent-reliability.test.js tests/generation-request.test.js tests/qiniu-storage.test.js tests/unicloud-storage.test.js",
    "test:agent-eval": "node --test tests/agent-evaluation.test.js tests/agent-reliability.test.js",
    "test:ui": "node --test tests/agent-pet-ui.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@vitejs/plugin-react": "latest",
    "aws4fetch": "^1.0.20",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "playwright": "^1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "latest"
  }
}
